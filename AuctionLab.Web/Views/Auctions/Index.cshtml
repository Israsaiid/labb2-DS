
@model IEnumerable<AuctionLab.Web.Models.ActiveAuctionVM>

@{
    ViewData["Title"] = "Active auctions";

    var userId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier
    )?.Value;
}

<!-- HERO SECTION -->
<section class="hero">
    <div class="hero-content">

        <span class="eyebrow">
            WELCOME TO MATCHA AUCTIONS
        </span>

        <h1>
            Unique matcha items.<br />
            Bid, collect, enjoy.
        </h1>

        <p>
            Discover and bid on high-quality matcha products,
            from traditional bowls to premium matcha powder.
        </p>

    </div>
</section>


<!-- ACTIVE AUCTIONS -->
<section class="auctions-section">

    <div class="section-heading">
        <h2>Active auctions</h2>
        <p>
            Explore our collection of matcha-inspired items.
        </p>
    </div>

    @if (Model.Any())
    {
        <div class="auction-grid">

            @foreach (var a in Model)
            {
                var imagePath = "/images/matcha-hero.png";

                if (a.Title.Contains(
                    "powder",
                    StringComparison.OrdinalIgnoreCase) ||
                    a.Title.Contains(
                        "pulver",
                        StringComparison.OrdinalIgnoreCase))
                {
                    imagePath = "/images/matcha-powder.jpg";
                }
                else if (a.Title.Contains(
                    "bowl",
                    StringComparison.OrdinalIgnoreCase) ||
                    a.Title.Contains(
                        "skål",
                        StringComparison.OrdinalIgnoreCase))
                {
                    imagePath = "/images/matcha-bowl.jpg";
                }
                else if (a.Title.Contains(
                    "cup",
                    StringComparison.OrdinalIgnoreCase) ||
                    a.Title.Contains(
                        "kopp",
                        StringComparison.OrdinalIgnoreCase))
                {
                    imagePath = "/images/matcha-cup.jpg";
                }

                <div class="auction-card">

                    <!-- PRODUCT IMAGE -->
                    <div class="card-art">
                        <img src="@imagePath"
                             alt="@a.Title" />
                    </div>

                    <!-- PRODUCT INFORMATION -->
                    <div class="auction-card-body">

                        <h3>@a.Title</h3>

                        <p>@a.Description</p>

                        <div class="auction-meta">

                            <div>
                                <small>Start price</small>
                                <strong>
                                    @a.StartPrice.ToString("0.00") kr
                                </strong>
                            </div>

                            <div>
                                <small>Ends</small>
                                <strong>
                                    @a.EndTime.ToString("dd MMM yyyy")
                                </strong>
                            </div>

                        </div>

                        <p class="seller-note">
                            Seller: @a.SellerName
                        </p>

                        <a asp-action="Details"
                           asp-route-id="@a.Id"
                           class="btn btn-primary w-100">
                            View auction
                        </a>

                        @if (User.Identity?.IsAuthenticated == true
                            && userId == a.SellerId)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@a.Id"
                               class="edit-link">
                                Edit auction
                            </a>
                        }

                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="content-panel text-center">
            <h3>No active auctions yet</h3>

            <p>
                There are currently no active auctions.
                Be the first to create one!
            </p>
        </div>
    }

    <div class="text-center mb-5">
        <a asp-action="Create"
           class="btn btn-primary">
            Create new auction
        </a>
    </div>

</section>
