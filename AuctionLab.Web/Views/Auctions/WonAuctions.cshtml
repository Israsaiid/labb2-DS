@model IEnumerable<AuctionLab.Web.Models.ActiveAuctionVM>

@{
    ViewData["Title"] = "Won auctions";
}

<h2>Won auctions</h2>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Start price</th>
            <th>Ended</th>
            <th>Seller</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.Title</td>
            <td>@a.Description</td>
            <td>@a.StartPrice</td>
            <td>@a.EndTime</td>
            <td>@a.SellerName</td>
            <td>
                <a asp-action="Details" asp-route-id="@a.Id">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
